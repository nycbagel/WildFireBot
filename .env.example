# Copy to .env and fill in the keys you have. The CLI loads .env without overriding
# variables that are already set. Open-Meteo does not need a key.
#
# NASA FIRMS MAP key: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=
# AirNow API key: https://docs.airnowapi.org/account/request/
AIRNOW_API_KEY=
# OpenAQ API key: https://docs.openaq.org/using-the-api/quick-start
OPENAQ_API_KEY=

# --- X (Twitter) mention bot, see docs/x-bot.md. Leave empty unless you run the bot. ---
# Dry run is the default: replies are printed, never posted. Set WFB_X_DRY_RUN=0 to go live.
WFB_X_DRY_RUN=1
# Read mentions (app-only bearer token from your X developer app)
X_BEARER_TOKEN=
# The bot account's numeric user id, or its @name without the @ (one of the two)
X_BOT_USER_ID=
X_BOT_USERNAME=
# Post replies (OAuth 1.0a user context of the bot account; needs Read and Write app permissions)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
