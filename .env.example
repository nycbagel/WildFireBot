# Copy this file to .env and fill in the keys. Never commit .env.
# This repository is public. A key in git history is a leaked key.

# https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# https://docs.airnowapi.org/
AIRNOW_API_KEY=

# api.weather.gov requires a User-Agent that identifies the app and a contact.
NWS_USER_AGENT=WildFireBot (you@example.com)
