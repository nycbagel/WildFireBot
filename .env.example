# Copy to .env and fill in the keys you have. The CLI loads .env without overriding
# variables that are already set. Open-Meteo does not need a key.
#
# NASA FIRMS MAP key: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=
# AirNow API key: https://docs.airnowapi.org/account/request/
AIRNOW_API_KEY=
# OpenAQ API key: https://docs.openaq.org/using-the-api/quick-start
OPENAQ_API_KEY=
